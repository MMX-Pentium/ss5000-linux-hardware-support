#!/bin/sh
set -u

CONFIG=/etc/default/ss5000-mgmt-prime
ANNOUNCE=/usr/local/libexec/ss5000-mgmt-announce

INTERFACE=mgmt0
EXPECTED_DRIVER=asix
EXPECTED_USB_ID=0b95:772b
PEER_IPV4=
POLL_SECONDS=1

if [ -r "$CONFIG" ]; then
	# This file is root-owned and contains only the variables above.
	. "$CONFIG"
fi

case "$POLL_SECONDS" in
	''|*[!0-9]*|0) POLL_SECONDS=1 ;;
esac

prime_link()
{
	device_path=$(readlink -f "/sys/class/net/$INTERFACE/device" 2>/dev/null) ||
		return 1
	driver=$(basename "$(readlink -f "$device_path/driver" 2>/dev/null)") ||
		return 1
	usb_device=${device_path%:*}
	vendor=$(cat "$usb_device/idVendor" 2>/dev/null) || return 1
	product=$(cat "$usb_device/idProduct" 2>/dev/null) || return 1
	if [ "$driver" != "$EXPECTED_DRIVER" ] ||
		[ "$vendor:$product" != "$EXPECTED_USB_ID" ]; then
		echo "SS5000 mgmt: refusing unexpected $INTERFACE device" \
			"driver=$driver usb=$vendor:$product" >&2
		return 0
	fi

	/usr/sbin/ip link set dev "$INTERFACE" up || return 1
	if ! /usr/sbin/ip -4 -o address show dev "$INTERFACE" scope global |
		grep -q .; then
		return 1
	fi

	# AX88772B multicast-mode updates rewrite RX_CTL.  Toggle IFF_ALLMULTI to
	# re-assert directed and broadcast reception on each new carrier.
	/usr/sbin/ip link set dev "$INTERFACE" allmulticast on || true
	sleep 0.1
	/usr/sbin/ip link set dev "$INTERFACE" allmulticast off || true

	# Transmitting is the observed workaround.  Gratuitous ARP also teaches
	# the attached PC the management MAC without waiting for a reply.
	"$ANNOUNCE" "$INTERFACE" || true
	if [ -n "$PEER_IPV4" ] && command -v ping >/dev/null 2>&1; then
		ping -n -q -c 1 -W 1 -I "$INTERFACE" "$PEER_IPV4" \
			>/dev/null 2>&1 || true
	fi
	"$ANNOUNCE" "$INTERFACE" || true

	echo "SS5000 mgmt: primed $INTERFACE (peer ${PEER_IPV4:-disabled})"
	return 0
}

primed=0
while :; do
	carrier=0
	if [ -r "/sys/class/net/$INTERFACE/carrier" ]; then
		carrier=$(cat "/sys/class/net/$INTERFACE/carrier" 2>/dev/null) ||
			carrier=0
	fi

	if [ "$carrier" = 1 ]; then
		if [ "$primed" = 0 ] && prime_link; then
			primed=1
		fi
	else
		primed=0
	fi
	sleep "$POLL_SECONDS"
done
